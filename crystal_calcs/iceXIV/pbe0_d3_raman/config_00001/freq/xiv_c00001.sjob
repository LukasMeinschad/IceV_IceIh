#!/bin/bash
#SBATCH --partition=CPU_rune
#SBATCH --nodelist=
#SBATCH -J XIV1_freq
#SBATCH -N 1
#SBATCH --ntasks-per-node=40
#SBATCH --cpus-per-task=1

source /usr/local/_tci_software_environment_.sh
module purge
# CHECK the exact CRYSTAL23 module name on rune:  module avail crystal
module load rune/crystal/23

#set some necessary environment before running
export CRY23_SCRDIR="/scratch/lme"
export CRY17_SCRDIR="/scratch/lme"

#run your job
# run only if the optimisation converged; its geometry (with symmetry) -> fort.34
grep -q "OPT END - CONVERGED" ../opt/xiv_c00001.out 2>/dev/null || { echo 'optimisation not converged - frequencies skipped'; exit 1; }
cp ../opt/xiv_c00001.gui ./xiv_c00001.gui || { echo 'opt geometry missing'; exit 1; }
runmpi23 40 xiv_c00001
